.env
.git
venv
.venv
__pycache__
.pytest_cache
node_modules

# Build artifacts
build
dist
*.egg-info

# OS / editor files
.DS_Store
Thumbs.db
.idea
.vscode

# Not needed in the runtime image
tests
docs
.github
README.md
*.md
.dockerignore
Dockerfile
.gitignore

# The React port under frontend/src is not wired into the served page,
# and its tests are not needed at runtime.
frontend/src
frontend/jest.setup.js

# Local JSON storage data — do not bake real/local task data into the image.
# The app writes app/storage/storage.json at runtime; mount a volume there
# if the container's tasks need to outlive the container.
app/storage/*.json
app/storage/*.json.tmp
app/storage/*.json.corrupt-*
data/*.json
*.db